<Window x:Class="PaperStok.App.Views.ConnectionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bağlantı Ayarları"
        Width="520" Height="680"
        MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,12,24,24">
            <Button Content="Bağlantıyı Test Et" Style="{StaticResource Pa.SecondaryButton}"
                    Click="TestConnection_Click" Margin="0,0,8,0" />
            <Button Content="İptal" Style="{StaticResource Pa.SecondaryButton}"
                    Click="Cancel_Click" Margin="0,0,8,0" />
            <Button Content="Kaydet" Style="{StaticResource Pa.PrimaryButton}"
                    Click="Save_Click" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,24,24,0">

        <TextBlock Text="Profil Adı" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" Margin="0,0,0,12" />

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Sunucu Adresi" Margin="0,0,0,4" />
                <TextBox x:Name="ServerBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Port (ops.)" Margin="0,0,0,4" />
                <TextBox x:Name="PortBox" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Veritabanı Adı (Linked Server doluysa ops.)" Margin="0,0,0,4" />
        <TextBox x:Name="DatabaseBox" Margin="0,0,0,12" />

        <TextBlock Text="Linked Server (ops.)" Margin="0,0,0,4" />
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Linked Server Adı" FontSize="11" Foreground="{StaticResource Pa.Ink500}" Margin="0,0,0,4" />
                <TextBox x:Name="LinkedServerNameBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Uzak Veritabanı Adı" FontSize="11" Foreground="{StaticResource Pa.Ink500}" Margin="0,0,0,4" />
                <TextBox x:Name="LinkedServerDatabaseBox" />
            </StackPanel>
        </Grid>
        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Pa.Ink500}" Margin="0,0,0,12">
            Yukarıdaki sunucuya bağlanıp Logo tablolarını doğrudan değil, o sunucuda tanımlı bir SQL Server linked server üzerinden okumak için doldurun (ör. gerçek Logo veritabanı başka bir sunucuda olup buraya linked server ile erişiliyorsa). Boş bırakılırsa normal yerel bağlantı kullanılır.
        </TextBlock>

        <TextBlock Text="Kimlik Doğrulama" Margin="0,0,0,4" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="SqlAuthRadio" Content="SQL Server" GroupName="Auth" IsChecked="True"
                         Checked="AuthMode_Changed" Margin="0,0,20,0" />
            <RadioButton x:Name="WindowsAuthRadio" Content="Windows" GroupName="Auth"
                         Checked="AuthMode_Changed" />
        </StackPanel>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Kullanıcı Adı" Margin="0,0,0,4" />
                <TextBox x:Name="UsernameBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Parola" Margin="0,0,0,4" />
                <PasswordBox x:Name="PasswordBox" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="PasswordHintText" Text="Mevcut profil için boş bırakılırsa kayıtlı parola korunur."
                   FontSize="11" Foreground="{StaticResource Pa.Ink500}" Margin="0,-8,0,12" Visibility="Collapsed" />

        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Firma No" Margin="0,0,0,4" />
                <TextBox x:Name="FirmNoBox" Text="1" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Dönem No" Margin="0,0,0,4" />
                <TextBox x:Name="PeriodNoBox" Text="1" />
            </StackPanel>
        </Grid>
        <TextBlock Text="Logo Tiger3 tablo ön eki: LG_&lt;Firma No&gt;_&lt;Dönem No&gt;_..."
                   FontSize="11" Foreground="{StaticResource Pa.Ink500}" Margin="0,4,0,12" />

        <TextBlock Text="Stok Kaynağı" Margin="0,0,0,4" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <RadioButton x:Name="ViewSourceRadio" Content="Görünüm (LV_) — önerilen" GroupName="StockSource" IsChecked="True" Margin="0,0,20,0" />
            <RadioButton x:Name="TableSourceRadio" Content="Tablo (LG_)" GroupName="StockSource" />
        </StackPanel>
        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Pa.Ink500}" Margin="0,0,0,12">
            Stok toplamları bazı kurulumlarda LG_...STINVTOT tablosunda, bazılarında ise aynı yapıdaki LV_...STINVTOT görünümünde günceldir (tabloyu besleyen toplam güncelleme işi çalışmıyorsa tablo eski kalır). Emin değilseniz Görünüm (LV_) seçili kalsın.
        </TextBlock>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <CheckBox x:Name="EncryptCheck" Content="Bağlantıyı şifrele (Encrypt)" IsChecked="True" Margin="0,0,20,0" />
            <CheckBox x:Name="TrustCertCheck" Content="Sunucu sertifikasına güven" IsChecked="True" />
        </StackPanel>

        <Expander x:Name="AdvancedExpander" Header="Gelişmiş: Özel Ambar Sorgusu (SQL)" Margin="0,0,0,12">
            <StackPanel Margin="0,8,0,0">
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Pa.Ink500}" Margin="0,0,0,6">
                    Logo kurulumunuz standart şemadan farklıysa varsayılan sorguyu burada
                    değiştirebilirsiniz. {FIRM}, {PERIOD}, {FIRMNO}, {STINVTOT_PREFIX} (yukarıdaki
                    Stok Kaynağı seçimine göre LG veya LV) ve {DB_PREFIX} (Linked Server dolduysa
                    dört parçalı ad ön eki, boşsa boş) yer tutucuları otomatik doldurulur.
                    Boş bırakılırsa PaperStok'un varsayılan sorgusu kullanılır.
                </TextBlock>
                <TextBlock x:Name="CustomQueryActiveText" TextWrapping="Wrap" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource Pa.Danger}" Margin="0,0,0,6" Visibility="Collapsed"
                           Text="⚠ Özel sorgu aktif — bu profille yapılan her Stokları Çek/Verileri Yenile bu kutudaki sorguyu kullanır, varsayılanı değil." />
                <TextBox x:Name="CustomQueryBox" AcceptsReturn="True" TextWrapping="Wrap"
                         FontFamily="{StaticResource Pa.FontMono}" Height="120"
                         VerticalScrollBarVisibility="Auto" TextChanged="CustomQueryBox_TextChanged" />
                <Button Content="Sıfırla (varsayılana dön)" Style="{StaticResource Pa.SecondaryButton}"
                        Click="ResetCustomQuery_Click" HorizontalAlignment="Left" Margin="0,8,0,0" />
            </StackPanel>
        </Expander>

        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,24" Visibility="Collapsed" />

        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
