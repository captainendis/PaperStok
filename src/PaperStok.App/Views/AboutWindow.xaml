<Window x:Class="PaperStok.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PaperStok Hakkında"
        Width="380" Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="32" HorizontalAlignment="Center">
        <Image Source="/Resources/paperaxis-mark-navy.png" Width="48" Height="48" Margin="0,0,0,16" />

        <TextBlock Text="PaperStok" FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center" Foreground="{StaticResource Pa.Navy900}" />
        <TextBlock x:Name="VersionText" Text="Sürüm 0.1.0" FontSize="13"
                   HorizontalAlignment="Center" Margin="0,2,0,20" Foreground="{StaticResource Pa.Ink600}" />

        <TextBlock Text="Bir PaperAxis ürünüdür." HorizontalAlignment="Center" Margin="0,0,0,4" />
        <TextBlock x:Name="CopyrightText" Text="© 2026 PaperAxis. Tüm hakları saklıdır."
                   HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource Pa.Ink500}" Margin="0,0,0,16" />

        <TextBlock HorizontalAlignment="Center" Margin="0,0,0,4">
            <Hyperlink NavigateUri="mailto:info@paperaxis.com" RequestNavigate="Hyperlink_RequestNavigate">
                info@paperaxis.com
            </Hyperlink>
        </TextBlock>
        <TextBlock HorizontalAlignment="Center" Margin="0,0,0,20">
            <Hyperlink NavigateUri="https://paperaxis.com/gizlilik" RequestNavigate="Hyperlink_RequestNavigate">
                Gizlilik Politikası
            </Hyperlink>
        </TextBlock>

        <Button Content="Kapat" Style="{StaticResource Pa.SecondaryButton}"
                Width="100" Click="CloseButton_Click" />
    </StackPanel>
</Window>
