<Window x:Class="PaperStok.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PaperStok"
        Width="1180" Height="720"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <DockPanel>

        <Menu DockPanel.Dock="Top" Background="White">
            <MenuItem Header="_Dosya">
                <MenuItem Header="_Yeni Bağlantı…" Click="NewProfile_Click" />
                <MenuItem Header="Bağlantıyı _Düzenle…" Click="EditProfile_Click" />
                <MenuItem Header="Bağlantıyı _Sil" Click="DeleteProfile_Click" />
                <Separator />
                <MenuItem Header="_Excel'e Aktar…" Click="ExportExcel_Click" />
                <MenuItem Header="_CSV'ye Aktar…" Click="ExportCsv_Click" />
                <Separator />
                <MenuItem Header="Çı_kış" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Raporlar">
                <MenuItem Header="_Ambar Raporu…" Click="StockReport_Click" />
            </MenuItem>
            <MenuItem Header="_Yardım">
                <MenuItem Header="PaperStok _Hakkında" Click="About_Click" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource Pa.Navy900}">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Hazır." Foreground="White" Margin="8,0" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="FooterText" Foreground="{StaticResource Pa.Navy200}" Margin="8,0" FontSize="11" />
            </StatusBarItem>
        </StatusBar>

        <Border DockPanel.Dock="Left" Width="280" Background="White" BorderBrush="{StaticResource Pa.Paper200}" BorderThickness="0,0,1,0">
            <StackPanel Margin="16">
                <TextBlock Text="Bağlantı Profili" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ComboBox x:Name="ProfileCombo" DisplayMemberPath="Name"
                          SelectionChanged="ProfileCombo_SelectionChanged" Margin="0,0,0,8" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="Yeni" Style="{StaticResource Pa.SecondaryButton}" Click="NewProfile_Click" Margin="0,0,6,0" />
                    <Button Content="Düzenle" Style="{StaticResource Pa.SecondaryButton}" Click="EditProfile_Click" Margin="0,0,6,0" />
                    <Button Content="Sil" Style="{StaticResource Pa.SecondaryButton}" Click="DeleteProfile_Click" />
                </StackPanel>

                <Border Background="{StaticResource Pa.Navy50}" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Firma / Dönem" FontSize="11" Foreground="{StaticResource Pa.Ink500}" Margin="0,0,0,2" />
                        <TextBlock x:Name="FirmPeriodText" Text="—" FontFamily="{StaticResource Pa.FontMono}" />
                        <TextBlock x:Name="CustomQueryWarningText" Text="⚠ Özel sorgu aktif" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource Pa.Danger}" Margin="0,4,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Button x:Name="PullStockButton" Content="Stokları Çek" Style="{StaticResource Pa.AccentButton}"
                        Click="PullStock_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Height="4" Visibility="Collapsed" Margin="0,0,0,8" />
                <Button Content="Ambar Raporu…" Style="{StaticResource Pa.SecondaryButton}"
                        Click="StockReport_Click" HorizontalAlignment="Stretch" Margin="0,0,0,16" />

                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Pa.Ink500}">
                    <Run Text="🔒" />
                    <Run Text="Salt okunur: PaperStok yalnızca okur, Logo Tiger3 veritabanında hiçbir kayıt eklemez, değiştirmez veya silmez." />
                </TextBlock>
            </StackPanel>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox" Grid.Column="0" Margin="0,0,8,0"
                         TextChanged="Filter_Changed"
                         ToolTip="Stok kodu veya adına göre ara" />
                <ComboBox x:Name="WarehouseFilterCombo" Grid.Column="1" Margin="0,0,8,0"
                          SelectionChanged="Filter_Changed" />
                <ComboBox x:Name="StatusFilterCombo" Grid.Column="2" Margin="0,0,8,0"
                          SelectionChanged="Filter_Changed" />
                <Button Grid.Column="3" Content="Excel'e Aktar" Style="{StaticResource Pa.SecondaryButton}"
                        Click="ExportExcel_Click" Margin="0,0,8,0" />
                <Button Grid.Column="4" Content="CSV'ye Aktar" Style="{StaticResource Pa.SecondaryButton}"
                        Click="ExportCsv_Click" />
            </Grid>

            <DataGrid x:Name="StockGrid" Grid.Row="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ambar Adı" Binding="{Binding WarehouseName}" Width="150" />
                    <DataGridTextColumn Header="Stok Kodu" Binding="{Binding ItemCode}" Width="130" />
                    <DataGridTextColumn Header="Stok Adı" Binding="{Binding ItemName}" Width="*" />
                    <DataGridTextColumn Header="Birim" Binding="{Binding Unit}" Width="70" />
                    <DataGridTextColumn Header="Eldeki" Binding="{Binding OnHand, StringFormat={}{0:#,##0.###}}" Width="90" />
                    <DataGridTextColumn Header="Rezerve" Binding="{Binding Reserved, StringFormat={}{0:#,##0.###}}" Width="90" />
                    <DataGridTextColumn Header="Sipariş" Binding="{Binding OnOrder, StringFormat={}{0:#,##0.###}}" Width="90" />
                    <DataGridTextColumn Header="Kullanılabilir" Binding="{Binding Available, StringFormat={}{0:#,##0.###}}" Width="110" />
                    <DataGridTextColumn Header="Durum" Binding="{Binding StatusLabel}" Width="70" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
